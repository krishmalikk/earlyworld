{
  "name": "earlyworld",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:rules": "firebase emulators:exec --project demo-earlyworld --only firestore 'node --import tsx --test tests/firestore.rules.test.mts'",
    "check": "npm run typecheck && npm test && npm --prefix functions run build",
    "seed": "tsx scripts/seed.ts",
    "catalog:collect": "tsx scripts/collect-catalog.ts",
    "test:backend": "firebase emulators:exec --project demo-earlyworld --only firestore 'node --import tsx --test tests/backend.test.mts'",
    "format": "prettier --write app src shared functions/src scripts tests docs README.md app.config.ts \"*.json\"",
    "format:check": "prettier --check app src shared functions/src scripts tests docs README.md app.config.ts \"*.json\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-firebase/analytics": "26.4.0",
    "@react-native-firebase/app": "26.4.0",
    "@react-native-firebase/auth": "26.4.0",
    "@react-native-firebase/crashlytics": "26.4.0",
    "@react-native-firebase/firestore": "26.4.0",
    "@react-native-firebase/functions": "26.4.0",
    "@react-native-firebase/storage": "26.4.0",
    "expo": "~57.0.24",
    "expo-build-properties": "~57.0.21",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.19",
    "expo-image-picker": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^22.18.0",
    "@types/react": "~19.2.0",
    "@types/react-test-renderer": "^19.3.0",
    "firebase-admin": "^13.6.0",
    "firebase-tools": "^15.30.2",
    "prettier": "^3.9.8",
    "react-test-renderer": "^19.2.3",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2"
  }
}
