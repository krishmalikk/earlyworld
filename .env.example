# Download native config files from your Firebase console; do not commit them.
GOOGLE_SERVICES_JSON=./google-services.json
GOOGLE_SERVICES_PLIST=./GoogleService-Info.plist
IOS_BUNDLE_ID=com.earlyworld.app
ANDROID_PACKAGE=com.earlyworld.app
EAS_PROJECT_ID=
# Google Sign-In: the Web client ID from Firebase Authentication > Sign-in method > Google.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Optional local development (device must reach this machine).
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=

# Server-only SoundCloud metadata access. Never prefix secrets with EXPO_PUBLIC_.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
