# Download native config files from your Firebase console; do not commit them.
GOOGLE_SERVICES_JSON=./google-services.json
GOOGLE_SERVICES_PLIST=./GoogleService-Info.plist
IOS_BUNDLE_ID=com.earlyworld.app
ANDROID_PACKAGE=com.earlyworld.app
EAS_PROJECT_ID=
# Use your Firebase Hosting origin for the YouTube iframe Referer.
EXPO_PUBLIC_EMBED_ORIGIN=https://YOUR_PROJECT_ID.web.app
# Optional local development (device must reach this machine).
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=
